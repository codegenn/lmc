<style>
  .table-container {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
<div class="sec-banner bg0 p-t-80 p-b-50 main-page">
  <% if @products.length > 0 %>
    <% @products&.each do |p| %>
      <div class="container">
        <%= render "admin/product", product: p %>
      </div>
    <% end %>
  <% else %>
    <div class="container">
      <div class="row">
        <div class="alert alert-success" role="alert">
          <%= I18n.t("partner.empty").html_safe %>
        </div>
      </div>
    </div>
  <% end %>
</div>
