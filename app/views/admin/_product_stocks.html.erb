<% # Define a custom order for sizes based on your needs %>
<% size_order = ["S", "M", "L", "XL", "XXL"] %>

<% # Sort product.stocks based on size_order %>
<% sorted_stocks = product.stocks.sort_by { |stock| size_order.index(stock.size) } %>

<% sorted_stocks.each do |stock| %>
  <div class="border px-2 mb-3 pb-2">
    <div class="row gx-3">
      <div class="col-md-3">
        <label for="size" class="form-label"><%= I18n.t("partner.size") %></label>
        <input type="text" class="form-control" value="<%= stock.size %>" disabled>
      </div>
      <div class="col-md-3">
        <label for="product_code" class="form-label"><%= I18n.t("partner.ma") %></label>
        <input type="text" class="form-control" value="<%= stock.product_code %>" disabled>
      </div>
      <div class="col-md-3">
        <label for="price" class="form-label"><%= I18n.t("partner.price") %></label>
        <input type="text" class="form-control" value="<%= product.price %>" disabled>
      </div>
      <div class="col-md-3">
        <label for="quantity" class="form-label"><%= I18n.t("partner.inventory") %></label>
        <input type="text" class="form-control" value="<%= stock.quantity %>" disabled>
      </div>
    </div>
  </div>
<% end %>
