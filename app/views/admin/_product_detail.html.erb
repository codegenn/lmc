<div style="display: flex; align-items: center; border: 1px solid #ccc; padding: 10px;">
  <div style="flex: 1;">
    <div style="margin-bottom: 10px; font-weight: bold; color: #333;">
      <%= link_to admin_products_path(product.id), style: "color: #333;"  do %>
        <%= product.title %> - <%= "#{number_with_delimiter(product.price.to_i, :delimiter => '.')} VND" %>
      <% end %>
    </div>
    <div>
      <%= render "admin/product_stocks", product: product, detail: detail %>
    </div>
  </div>
</div>
