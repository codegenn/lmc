<div style="display: flex; align-items: center; border: 1px solid #ccc; padding: 10px; margin-bottom: 15px;">
  <div style="width: 100px; margin-right: 20px;">
    <%= image_tag product&.product_images.first.try(:image_url), width: "100px" %>
  </div>
  <div style="flex: 1;">
    <div style="margin-bottom: 10px;">
      <%= link_to admin_products_path(product.id), style: "font-weight: bold; color: #333;" do %>
        <%= product.title %> - <%= product.price %>
      <% end %>
    </div>
    <div>
      <%= render "admin/product_stocks", product: product %>
    </div>
  </div>
</div>
