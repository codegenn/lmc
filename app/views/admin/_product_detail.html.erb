<div style="display: flex; align-items: center; border: 1px solid #ccc; padding: 10px;">
  <div style="flex: 1;">
    <div style="margin-bottom: 10px;">
      <%= link_to admin_products_path(product.id), style: "font-weight: bold; color: #333;" do %>
        <%= product.title %> - <%= product.price %>
      <% end %>
    </div>
    <div>
      <%= render "admin/product_stocks", product: product, details: details %>
    </div>
  </div>
</div>
