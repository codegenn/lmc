<style>
  .font-bold {
    font-weight: bold;
    background-color: lightgray;
  }

  @media (min-width: 768px) {
    .fixed-input-height {
      height: calc(1.5em + 0.75rem + 2px); /* Adjust this value to match your design */
    }
    .height-class {
      height: 150px;
    }
    .fixed-label-height {
      display: flex;
      align-items: center;
      height: 100%;
    }
  }

  @media (max-width: 768px) {
    .height-class {
      height: 465px;
    }
  }
</style>
<div class="table-responsive mb-3">
  <table class="table table-bordered">
    <thead class="thead-light">
      <tr>
        <th scope="col" class="font-bold font-weight-bold text-center"><%= I18n.t("partner.time") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.sold_product") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.revenue") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.fee") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.status") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.time_pay") %></th>
        <th scope="col" class="font-bold text-center"><%= I18n.t("partner.note") %></th>
      </tr>
    </thead>
    <tbody>
      <% products&.each do |p| %>
        <% manages = p.partner_managers %>
        <tr>
          <td scope="row" class="text-right">
            <%= p&.start_time&.strftime('%d-%m-%Y') %> - <%= p&.end_time&.strftime('%d-%m-%Y') %>
          </td>
          <td class="text-right">
            <a href="#" data-toggle="modal" data-target="#productModal<%= p.id %>">
              <%= p.total_sell %>
            </a>
          </td>
          <td class="text-right"><%= "#{number_with_delimiter(p.revenue.to_i, :delimiter => '.')} VND" %></td>
          <td class="text-right"><%= "#{number_with_delimiter(p.fee.to_i, :delimiter => '.')}%" %></td>
          <td class="text-right"><%= "#{number_with_delimiter(p.time_pay.to_i, :delimiter => '.')} VND" %></td>
          <td scope="row" class="text-right">
            <%= p&.time_pay_partner&.strftime('%d-%m-%Y') %>
          </td>
          <td scope="row" class="text-right">
            <%= p&.note %>
          </td>
        </tr>

        <!-- Modal -->
        <div class="modal fade" id="productModal<%= p.id %>" tabindex="-1" role="dialog" aria-labelledby="productModal<%= p.id %>Title" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <%= p&.start_time&.strftime('%d-%m-%Y') %> - <%= p&.end_time&.strftime('%d-%m-%Y') %>
              </div>
              <% manages.each do |manage| %>
                <div class="modal-body">
                  <% # Sort product.stocks based on size_order %>
                  <% stock = Stock.find(manage.product_id) %>
                  <% products = Product.find(stock.product_id) %>
                  <%= render "admin/product_detail", product: products, detail: manage %>
                </div>
              <% end %>
              <div class="modal-footer py-4">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </tbody>
  </table>

</div>
