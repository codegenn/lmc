:css
  .discount-amount {
    position: absolute;
    top: 35%;
    left: 34%;
    width: 15%;
    height: 25%;
    text-align: end;
    font-size: 7rem;
    line-height: 50%;
    color: #041d44;
  }

  .discount-amount-pc {
    position: absolute;
    top: 35%;
    left: 34%;
    width: 15%;
    height: 25%;
    text-align: end;
    font-size: 7rem;
    line-height: 40%;
    color: #041d44;
  }

  .wrapper-discount {
    display: block;
    height: 303px;
    width: 100%;
    position: relative;
    border: 2px solid #343a40;
    -# border-left: 40px solid #343a40;
    padding: 15px;
    color: rgba(0, 0, 0, 0.5);
    font-size: small;
    display: inline-block;
    background-size: contain;
    background-repeat: no-repeat;
    background-image: url(#{image_path "discount-pc.jpeg"})
  }
  .discount-banner {
    display:block;
    position: fixed;
    bottom: 30%;
    right: -3px;
    height: 300px;
    width: 614px;
    z-index: 9999;
    transition: transform 1s;
  }

  .wrapper-text-outside {
    font-size: 20px;
    width: 301px;
    height: 35px;
    text-align: center;
    color: white;
    text-transform: uppercase;
    letter-spacing: 3px;
    position: absolute;
    bottom: -36px;;
    left: 28px;
    margin-left: -30px;
    transform: rotate(270deg);
    transform-origin: 0 0;
    font-weight: 800;
  }

  .discount-banner-content-hide {
    transform: translateX(576px);
  }

  .button-discount {
    position: absolute;
    bottom: 50px;
    right: 93px;
    background-color: rgb(248, 168, 149);
    color: rgb(255, 255, 255);
    border-radius: 0;
    border: 1px solid #f08679;
    height: 36px;
    font-size: 12px;
    font-weight: 700;
    min-width: 144px;
    line-height: 34px;
    padding: 0 16px;
    user-select: none;
    text-decoration: none;
    text-transform: uppercase;
    outline: 0;
    letter-spacing: 3px;
  }

  .input-discount {
    position: absolute;
    bottom: 50px;
    right: 245px;
    height: 36px;
    width: 205px;
    color: rgb(45, 45, 45);
    padding: 0 12px;
    outline: 0;
    background-color: rgb(255, 255, 255);
  }

  @media only screen and (max-width: 775px) {
    .parner-title {
      font-size: 17px;
    }

    .partner-mobile{
      width: 25%;
      margin: 0 10px;
    }

    .wrapper-discount {
      background-image: url(#{image_path "discount-mobile.jpg"});
      height: 261px;
    }

    .discount-banner {
      width: 300px;
    }

    .discount-banner-content-hide {
      transform: translateX(260px);
    }

    .button-discount {
      bottom: 23px;
      right: 45px;
      height: 31px;
      font-size: 10px;
      width: 125px;
      left:auto !important;
      min-width: auto !important;
      line-height: 31px;
    }

    .input-discount {
      bottom: 23px;
      left: 45px;
      height: 32px;
      width: 175px;
      font-size: 10px;
    }

    .wrapper-text-outside {
      bottom: -30px;
    }

    .discount-banner {
      display: none;
      width: 300px;
    }

    .wrapper-text-outside {
      bottom: -30px;
    }

    .discount-amount {
      position: absolute;
      top: 40%;
      left: 47%;
      width: 26%;
      height: 21%;
      text-align: end;
      font-size: 18vw;
      line-height: 55%;
      color: #041d44;
    }
  }

%form{:action => "/subcribers-user", :method => "post"}
  .discount-banner.discount-banner-content-hide
    .wrapper-discount
      %span.wrapper-text-outside
      -#   = "Giảm giá #{@amount}%"
      -# %span.discount-amount
      -#   = @amount
      %button.button-discount{:type => "submit"}
        = I18n.t "user.signup_btn"
      %input.input-discount{:placeholder => I18n.t("phone_submit"), :phone => "phone"}


:javascript
  $(document).ready(function() {
    $(".wrapper-text-outside").on("click", function() {
      let parent = $(this).closest('.discount-banner');
      if($(parent).hasClass('discount-banner-content-hide')) {
        $(parent).removeClass('discount-banner-content-hide');
      } else {
        $(parent).addClass('discount-banner-content-hide');
      }
    });
  });
